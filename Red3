-- ================= ระบบการทำงาน =================

-- สลับการแสดงผลเมนู
OpenCloseBtn.MouseButton1Click:Connect(function()
    MainFrame.Visible = not MainFrame.Visible
end)

-- กดปุ่มดึงแร่
MagnetBtn.MouseButton1Click:Connect(function()
    MagnetActive = not MagnetActive
    if MagnetActive then
        MagnetBtn.Text = "🧲 ดึงแร่ : ON"
        MagnetBtn.BackgroundColor3 = Color3.fromRGB(40, 180, 40)
    else
        MagnetBtn.Text = "🧲 ดึงแร่ : OFF"
        MagnetBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
    end
end)

-- กดปุ่มออโต้คลิก
AutoClickBtn.MouseButton1Click:Connect(function()
    AutoClickActive = not AutoClickActive
    if AutoClickActive then
        AutoClickBtn.Text = "⚡ ออโต้คลิก : ON"
        AutoClickBtn.BackgroundColor3 = Color3.fromRGB(40, 180, 40)
    else
        AutoClickBtn.Text = "⚡ ออโต้คลิก : OFF"
        AutoClickBtn.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
    end
end)

-- ลูปดึงแร่
task.spawn(function()
    while task.wait(0.1) do
        if MagnetActive then
            local char = game.Players.LocalPlayer.Character
            if char and char:FindFirstChild("HumanoidRootPart") then
                local hrp = char.HumanoidRootPart
                for _, item in pairs(workspace:GetDescendants()) do
                    if item:IsA("BasePart") and not item:IsDescendantOf(char) then
                        local name = item.Name:lower()
                        if name:find("ore") or name:find("gem") or name:find("coin") or name:find("drop") or item.Parent.Name:lower():find("ore") then
                            item.Anchored = false
                            item.CanCollide = false
                            item.CFrame = hrp.CFrame
                        end
                    end
                end
            end
        end
    end
end)

-- ลูปออโต้คลิก
task.spawn(function()
    while task.wait(0.01) do
        if AutoClickActive then
            for _, v in pairs(game:GetService("ReplicatedStorage"):GetDescendants()) do
                if v:IsA("RemoteEvent") and (v.Name:lower():find("click") or v.Name:lower():find("mine") or v.Name:lower():find("tap")) then
                    v:FireServer()
                end
            end
        end
    end
end)
