-- 2. 🦘 แก้บั๊ก Infinite Jump (ทำงานชัวร์ 100%)
UserInputService.JumpRequest:Connect(function()
    if isInfJump() then
        local char = LocalPlayer.Character
        if char then
            local humanoid = char:FindFirstChildOfClass("Humanoid")
            if humanoid then
                humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
            end
        end
    end
end)

-- 3. 🎯 ฟังก์ชันหาศัตรูที่ใกล้เป้าที่สุด (สำหรับ Aimbot)
local function getClosestPlayer()
    local closest = nil
    local shortestDist = FOVCircle.Radius
    local mousePos = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)

    for _, plr in pairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
            local hum = plr.Character:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health > 0 then
                local pos, onScreen = Camera:WorldToViewportPoint(plr.Character.HumanoidRootPart.Position)
                if onScreen then
                    local dist = (Vector2.new(pos.X, pos.Y) - mousePos).Magnitude
                    if dist < shortestDist then
                        shortestDist = dist
                        closest = plr
                    end
                end
            end
        end
    end
    return closest
end

-- 4. 👁️ ระบบ ESP มองทะลุ (Box & Name)
local ESPFolder = Instance.new("Folder")
ESPFolder.Name = "ESP_Storage"
ESPFolder.Parent = ScreenGui

local function updateESP()
    ESPFolder:ClearAllChildren()
    if not isESP() then return end

    for _, plr in pairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
            local char = plr.Character
            local bb = Instance.new("BillboardGui")
            bb.Parent = ESPFolder
            bb.Adornee = char:FindFirstChild("Head") or char.HumanoidRootPart
            bb.Size = UDim2.new(0, 100, 0, 40)
            bb.StudsOffset = Vector3.new(0, 2.5, 0)
            bb.AlwaysOnTop = true

            local txt = Instance.new("TextLabel")
            txt.Parent = bb
            txt.Size = UDim2.new(1, 0, 1, 0)
            txt.Text = plr.Name .. "\n[" .. math.floor((plr.Character.HumanoidRootPart.Position - LocalPlayer.Character.HumanoidRootPart.Position).Magnitude) .. "m]"
            txt.TextColor3 = Color3.fromRGB(255, 60, 60)
            txt.TextSize = 12
            txt.Font = Enum.Font.SourceSansBold
            txt.BackgroundTransparency = 1
            txt.TextStrokeTransparency = 0
        end
    end
end

-- 5. 🔄 Main Loop (RenderStepped & Stepped)
RunService.Stepped:Connect(function()
    local char = LocalPlayer.Character
    if not char then return end
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    local hrp = char:FindFirstChild("HumanoidRootPart")

    if not humanoid or not hrp then return end

    -- เดินทะลุกำแพง (Noclip)
    if isNoclip() then
        for _, part in pairs(char:GetDescendants()) do
            if part:IsA("BasePart") then
                part.CanCollide = false
            end
        end
    end

    -- วิ่งเร็ว (Speed)
    if isSpeed() then
        humanoid.WalkSpeed = 60
    else
        if humanoid.WalkSpeed == 60 then
            humanoid.WalkSpeed = 16
        end
    end

    -- ✈️ แก้บั๊ก Fly (บินไม่พุ่งไปเอง คุมตามปุ่มเดิน)
    if isFly() then
        local moveDir = humanoid.MoveDirection
        if moveDir.Magnitude > 0 then
            hrp.Velocity = (moveDir * 50) + Vector3.new(0, 1, 0)
        else
            hrp.Velocity = Vector3.new(0, 1, 0) -- ลอยอยู่นิ่งๆ ไม่พุ่งมั่ว
        end
    end

    -- 📦 ขยาย Hitbox ศัตรู
    for _, plr in pairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character and plr.Character:FindFirstChild("HumanoidRootPart") then
            local targetHRP = plr.Character.HumanoidRootPart
            if isHitbox() then
                targetHRP.Size = Vector3.new(12, 12, 12)
                targetHRP.Transparency = 0.7
                targetHRP.BrickColor = BrickColor.new("Really blue")
                targetHRP.CanCollide = false
            else
                targetHRP.Size = Vector3.new(2, 2, 1)
                targetHRP.Transparency = 1
            end
        end
    end
end)

RunService.RenderStepped:Connect(function()
    -- อัปเดตวงกลม FOV
    FOVCircle.Position = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    FOVCircle.Visible = isFOV()

    -- 🎯 Aimbot ล็อกเป้า
    if isAimbot() then
        local target = getClosestPlayer()
        if target and target.Character then
            local head = target.Character:FindFirstChild("Head") or target.Character:FindFirstChild("HumanoidRootPart")
            if head then
                Camera.CFrame = CFrame.new(Camera.CFrame.Position, head.Position)
            end
        end
    end

    -- อัปเดตมองทะลุ ESP
    updateESP()
end)
