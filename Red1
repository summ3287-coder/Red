local function createCategoryHeader(parent, text, posY)
    local header = Instance.new("TextLabel")
    header.Parent = parent
    header.Position = UDim2.new(0, 0, 0, posY)
    header.Size = UDim2.new(1, 0, 0, 26)
    header.BackgroundColor3 = Color3.fromRGB(60, 70, 220)
    header.Text = "  " .. text
    header.TextColor3 = Color3.fromRGB(255, 255, 255)
    header.TextXAlignment = Enum.TextXAlignment.Left
    header.Font = Enum.Font.SourceSansBold
    header.TextSize = 13
    Instance.new("UICorner", header).CornerRadius = UDim.new(0, 6)
    return header
end

local function createToggleRow(parent, text, posY)
    local row = Instance.new("Frame")
    row.Parent = parent
    row.Position = UDim2.new(0, 0, 0, posY)
    row.Size = UDim2.new(1, 0, 0, 34)
    row.BackgroundColor3 = Color3.fromRGB(30, 33, 48)
    Instance.new("UICorner", row).CornerRadius = UDim.new(0, 6)

    -- ปุ่มวงกลม Toggle Icon ด้านซ้าย
    local toggleCircle = Instance.new("Frame")
    toggleCircle.Parent = row
    toggleCircle.Position = UDim2.new(0.04, 0, 0.22, 0)
    toggleCircle.Size = UDim2.new(0, 18, 0, 18)
    toggleCircle.BackgroundColor3 = Color3.fromRGB(20, 22, 32)
    Instance.new("UICorner", toggleCircle).CornerRadius = UDim.new(1, 0)

    local circleStroke = Instance.new("UIStroke")
    circleStroke.Color = Color3.fromRGB(100, 110, 140)
    circleStroke.Thickness = 2
    circleStroke.Parent = toggleCircle

    local innerDot = Instance.new("Frame")
    innerDot.Parent = toggleCircle
    innerDot.Position = UDim2.new(0.2, 0, 0.2, 0)
    innerDot.Size = UDim2.new(0.6, 0, 0.6, 0)
    innerDot.BackgroundColor3 = Color3.fromRGB(80, 220, 120)
    innerDot.Visible = false
    Instance.new("UICorner", innerDot).CornerRadius = UDim.new(1, 0)

    local label = Instance.new("TextLabel")
    label.Parent = row
    label.Position = UDim2.new(0.13, 0, 0, 0)
    label.Size = UDim2.new(0.8, 0, 1, 0)
    label.Text = text
    label.TextColor3 = Color3.fromRGB(220, 220, 230)
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.Font = Enum.Font.SourceSans
    label.TextSize = 13
    label.BackgroundTransparency = 1

    local btn = Instance.new("TextButton")
    btn.Parent = row
    btn.Size = UDim2.new(1, 0, 1, 0)
    btn.BackgroundTransparency = 1
    btn.Text = ""

    local state = false
    btn.MouseButton1Click:Connect(function()
        state = not state
        innerDot.Visible = state
        circleStroke.Color = state and Color3.fromRGB(80, 220, 120) or Color3.fromRGB(100, 110, 140)
    end)

    return btn, function() return state end
end

